# `cp .env.example .env` してから使う。Next.js と Prisma CLI の両方が読み込む。
DATABASE_URL="postgresql://tabiori:tabiori@localhost:5432/tabiori"

# セッションの署名に使う秘密鍵（32文字以上）。`openssl rand -base64 32` で生成して設定する
BETTER_AUTH_SECRET=""
# アプリの URL
BETTER_AUTH_URL="http://localhost:3000"
# スマホ実機などから別の URL でアクセスする場合に、カンマ区切りで追加する（任意）
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.0.10:3000"
