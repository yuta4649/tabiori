generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 日付（@db.Date）と時刻（@db.Time）は旅行先の現地時間として保存する。
// どのタイムゾーンの現地時間かは Trip.timezone（IANA 名）で決まる。

model Trip {
  id          String   @id @default(uuid(7)) @db.Uuid
  // 旅行の作成者。共有機能を入れるときは TripMember を追加し、閲覧・編集できる範囲を広げる（src/server/authz.ts）
  ownerId     String   @map("owner_id")
  title       String
  destination String
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  timezone    String   @default("Asia/Tokyo")
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  places        Place[]
  scheduleItems ScheduleItem[]

  @@index([ownerId])
  @@map("trips")
}

enum PlacePriority {
  MUST
  WANT
  MAYBE

  @@map("place_priority")
}

// 行きたい場所。スケジュールとは独立して管理し、予定から任意で参照される。
model Place {
  id        String        @id @default(uuid(7)) @db.Uuid
  tripId    String        @map("trip_id") @db.Uuid
  name      String
  address   String?
  url       String?
  memo      String?
  priority  PlacePriority @default(WANT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  scheduleItems ScheduleItem[]

  @@index([tripId])
  @@map("places")
}

model ScheduleItem {
  id        String    @id @default(uuid(7)) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  placeId   String?   @map("place_id") @db.Uuid
  date      DateTime  @db.Date
  startTime DateTime? @map("start_time") @db.Time(0)
  endTime   DateTime? @map("end_time") @db.Time(0)
  title     String
  location  String?
  memo      String?
  url       String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([tripId, date, startTime])
  @@index([placeId])
  @@map("schedule_items")
}

// ---- Better Auth ----
// `auth generate`（Better Auth CLI）の出力をもとに、テーブル名・列名をこのプロジェクトの規約に合わせたもの。
// Better Auth はモデル名とフィールド名でアクセスするため、フィールド名は変更しないこと。

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]
  trips    Trip[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}
